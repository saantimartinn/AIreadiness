# Server-side only. Never expose this key in frontend code.
OPENAI_API_KEY=your_openai_api_key_here

# Optional. Change it if your OpenAI account uses another available model.
OPENAI_MODEL=gpt-4o-mini

# Optional. Only needed when running the legacy local Express chat server.
CHAT_SERVER_PORT=8787

# Frontend optional override. In Vercel, leave this unset so the app uses /api/chat.
# VITE_CHAT_API_URL=http://localhost:8787/api/chat
